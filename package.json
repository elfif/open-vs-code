{
  "name": "open-vs-code",
  "displayName": "Open VS Code",
  "description": "OpenCode integration for VS Code with a read-only session browser sidebar.",
  "version": "0.0.1",
  "publisher": "open-vs-code",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:openVsCode.sidebar",
    "onCommand:openVsCode.openPanel",
    "onCommand:openVsCode.addFilesToSession",
    "onCommand:openVsCode.addSelectionToSession"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openVsCode.openPanel",
        "title": "Open OpenCode Panel"
      },
      {
        "command": "openVsCode.addFilesToSession",
        "title": "OpenCode: Add to Session"
      },
      {
        "command": "openVsCode.addSelectionToSession",
        "title": "OpenCode: Add to Session"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "openVsCode.addFilesToSession",
          "when": "false"
        },
        {
          "command": "openVsCode.addSelectionToSession",
          "when": "editorHasSelection && resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "openVsCode.addFilesToSession",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "openVsCode.addSelectionToSession",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "navigation@100"
        }
      ]
    },
    "keybindings": [
      {
        "command": "openVsCode.addSelectionToSession",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      },
      {
        "command": "openVsCode.addFilesToSession",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "filesExplorerFocus && !explorerResourceIsFolder && !inputFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openVsCode",
          "title": "OpenCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "openVsCode": [
        {
          "type": "webview",
          "id": "openVsCode.sidebar",
          "name": "OpenCode"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "node esbuild.mjs",
    "build:webview": "npm --prefix webview run build",
    "watch": "concurrently -n extension,webview -c blue,green \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "node esbuild.mjs --watch",
    "watch:webview": "npm --prefix webview run watch",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json && npm --prefix webview run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@opencode/client": "^2.2.0"
  }
}
